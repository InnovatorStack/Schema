<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework Condition="'$(HostTestFramework)' == ''">net8.0</TargetFramework>
        <TargetFramework Condition="'$(HostTestFramework)' != ''">$(HostTestFramework)</TargetFramework>
        <TargetFrameworks />
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <DefineConstants>$(DefineConstants);ARAS_TESTS</DefineConstants>
        <NuGetLockFilePath Condition="'$(TestIomPath)' != '' and '$(ArtifactsPath)' != ''">$(ArtifactsPath)/locks/$(MSBuildProjectName).packages.lock.json</NuGetLockFilePath>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/InnovatorSchema/InnovatorSchema.csproj" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.8.0" />
        <PackageReference Include="Newtonsoft.Json" />
        <PackageReference Include="Aras.IOM" Condition="'$(TestIomPath)' == ''" />
        <Reference Include="IOM" Condition="'$(TestIomPath)' != ''">
            <HintPath>$(TestIomPath)</HintPath>
            <Private>true</Private>
        </Reference>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <Compile Include="../Fixtures/*.cs" Link="Fixtures/%(Filename)%(Extension)" />
        <None Include="../../examples/*Method.cs" Link="%(Filename)%(Extension)"
              CopyToOutputDirectory="Always" />
        <None Include="../ServerMethods/*.cs" Link="ServerMethods/%(Filename)%(Extension)"
              CopyToOutputDirectory="Always" />
        <None Include="../Fixtures/Assembly.xml" Link="Assembly.xml"
              CopyToOutputDirectory="Always" />
    </ItemGroup>
</Project>
